{
  "name": "reci-transport",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "mobile": "pnpm --filter mobile start"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.16.1 <7",
      "dompurify": ">=3.4.17 <4",
      "node-forge@<1.4.3": "^1.4.3",
      "undici@>=6 <6.29.1": "^6.29.1",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "fast-uri@>=3 <3.1.9": "^3.1.9",
      "handlebars@<4.7.10": "^4.7.10",
      "source-map-js@<1.2.2": "^1.2.2",
      "compression@<1.8.2": "^1.8.2"
    }
