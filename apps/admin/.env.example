NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Sentry (error monitoring)
NEXT_PUBLIC_SENTRY_DSN=

# Maintenance assistant (app/api/admin/maintenance). The admin app does not see the web app's .env.local.
ANTHROPIC_API_KEY=

# Licence (white-label copies only). Off unless LICENCE_ENFORCEMENT=1; never set it on RECI's own deployment.
# LICENCE_KEY is the one-line text the owner issues (FKL1.…). Over the vehicle limit or lapsed only refuses ADDING a vehicle.
LICENCE_ENFORCEMENT=
LICENCE_KEY=
