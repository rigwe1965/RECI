{
  "expo": {
    "name": "RECI Transport",
    "slug": "reci-transport",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "recitransport",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.recitransport.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#407E3C"
      },
      "package": "de.recitransport.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": [],
          "enableGooglePay": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#407E3C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
