# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@recitransport.de

# Anthropic (AI features — Phase 1+)
ANTHROPIC_API_KEY=
# Optional: choose the Claude model. Leave all of these empty to keep the built-in models (Sonnet 4.6 for chat, search, trip,
# corporate and licence/damage vision; Haiku 4.5 for extras and maintenance). AI_MODEL changes every feature at once, and a feature
# setting beats it. Allowed: claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5, claude-fable-5-2, claude-sonnet-5, claude-opus-5,
# claude-opus-4-8, claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5-20251001. An unknown value is ignored (with a log warning).
# Bigger models cost more: AI_MODEL_EXTRAS runs on every extras page load, so keep it on a small model.
# AI_MODEL=
# AI_MODEL_CHAT=
# AI_MODEL_SEARCH=
# AI_MODEL_TRIP=
# AI_MODEL_CORPORATE=
# AI_MODEL_EXTRAS=
# AI_MODEL_MAINTENANCE=
# AI_VISION_MODEL=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Cron jobs (Phase 8 — pricing signals)
CRON_SECRET=                           # Random secret, sent as x-cron-secret header by Vercel Cron

# Monitoring (Phase 7)
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Expo Mobile (mirrors Supabase vars)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# White-label brand (all optional: leave unset and the site shows RECI Transport / Berlin exactly as before).
# NEXT_PUBLIC_ so the same words reach pages, e-mails, AI prompts and the browser; read at BUILD time, so rebuild after a change.
# Set the name first: short name, legal name and collection point then follow it unless set here.
# After a rename, also set every contact address below: any left unset still shows RECI's (check with brandLeftovers).
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_SHORT_NAME=
NEXT_PUBLIC_BRAND_LEGAL_NAME=
NEXT_PUBLIC_BRAND_EMAIL_LEGAL_NAME=
NEXT_PUBLIC_BRAND_CITY=
NEXT_PUBLIC_BRAND_COUNTRY=
NEXT_PUBLIC_BRAND_TIME_ZONE=
NEXT_PUBLIC_BRAND_HQ_NAME=
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=
NEXT_PUBLIC_BRAND_CONTACT_EMAIL=
NEXT_PUBLIC_BRAND_BOOKINGS_EMAIL=
NEXT_PUBLIC_BRAND_LEGAL_EMAIL=
NEXT_PUBLIC_BRAND_PRIVACY_EMAIL=
NEXT_PUBLIC_BRAND_CORPORATE_EMAIL=

# Licence (white-label copies only). Off unless LICENCE_ENFORCEMENT=1; never set it on RECI's own deployment.
# LICENCE_KEY is the one-line text the owner issues (FKL1.…). Over the vehicle limit or lapsed only refuses ADDING a vehicle.
LICENCE_ENFORCEMENT=
LICENCE_KEY=
